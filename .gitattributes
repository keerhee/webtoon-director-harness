# Normalize all text files to LF in the repository
* text=auto eol=lf

# Explicit text types
*.md      text eol=lf
*.txt     text eol=lf
*.yaml    text eol=lf
*.yml     text eol=lf
*.toml    text eol=lf
*.py      text eol=lf
*.svg     text eol=lf
*.json    text eol=lf
*.sh      text eol=lf

# Binary assets — never convert
*.png     binary
*.jpg     binary
*.jpeg    binary
*.webp    binary
*.gif     binary
*.pdf     binary
*.psd     binary
*.clip    binary
*.zip     binary
